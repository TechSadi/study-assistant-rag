# Copy to .env (or .env.local) and fill in. These values end up in the browser
# bundle, so only public values belong here.

# Supabase project URL and anon / publishable key (Project Settings -> API).
# Never put the service role / secret key in the frontend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=
