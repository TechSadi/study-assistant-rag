# Copy to .env and fill in. Only the backend reads this file. Never commit .env.

# --- Required ---------------------------------------------------------------

# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Supabase project (Project Settings -> API / Data API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Service role / secret key: server only. It bypasses Row Level Security and is
# used only for the private Storage bucket. Never put it in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase PostgreSQL (Connect -> Session pooler). Without it a local SQLite file
# (data/skimmi-dev.db) is used, which is only suitable for development.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# --- Optional ---------------------------------------------------------------

# Only if your project still signs tokens with the legacy shared JWT secret
# (Project Settings -> JWT Keys). Projects on the new signing keys don't need it:
# tokens are then verified with the project's public keys.
# SUPABASE_JWT_SECRET=

# Hugging Face token, used when downloading the embedding model
# HF_TOKEN=

# Storage: "supabase" (default) or "local" (files under data/uploads, offline dev only)
# SKIMMI_STORAGE_BACKEND=supabase
# SKIMMI_STORAGE_BUCKET=documents

# Frontend origins allowed to call the API (comma-separated; never "*")
# SKIMMI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Limits
# SKIMMI_MAX_UPLOAD_MB=25
# SKIMMI_MAX_DOCUMENTS=100
# SKIMMI_CHAT_PER_MINUTE=15
# SKIMMI_UPLOADS_PER_HOUR=30

# Timeouts in seconds (Supabase requests, Gemini requests)
# SKIMMI_HTTP_TIMEOUT=30
# SKIMMI_GEMINI_TIMEOUT=60

# Startup behaviour (defaults shown)
# SKIMMI_AUTO_MIGRATE=true          # apply Alembic migrations when the backend starts
# SKIMMI_RECOVER_ON_STARTUP=true    # rebuild missing/outdated vector indexes from storage

# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest
# SKIMMI_DATA_DIR=data
